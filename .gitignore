# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
frontend-modern/*.log
frontend-modern/*.err.log
rust-exchange/*_stdout.log
rust-exchange/*_stderr.log

# Data directories
data/
*.db
*.sqlite
!docs/benchmarks/archives/**/data/
!docs/benchmarks/archives/**/data/**/
!docs/benchmarks/archives/**/data/**/manifest.json

# Environment files
.env
.env.local
.env.*.local

# Configuration overrides
config.local.yaml
config.production.yaml
config.local.toml
rust-exchange/config.local.toml

# Claude Code agent harness state (never committed)
.claude/

# C#/.NET bench scratch (under rust-exchange/scripts/*_bench/)
rust-exchange/scripts/**/obj/
rust-exchange/scripts/**/bin/Debug/
rust-exchange/scripts/**/bin/Release/

# Per-run benchmark log captures (raw logs, not committed — the JSON
# summary at the parent level IS committed; logs are reproducer
# scratch).
docs/benchmarks/*/raw/**/*.log
docs/benchmarks/*/raw/**/*.log.err
docs/benchmarks/*/raw/**/*.err

# Build artifacts
bin/
dist/
build/
rust-exchange/target/
rust-exchange/target2/
rust-exchange/target-scale/
rust-exchange/target-scale2/
rust-exchange/target-scale3/
rust-exchange/target-scale4/
rust-exchange/target-scale5/

# Build/check/test/bench scratch logs (rust-exchange root)
rust-exchange/build_*.txt
rust-exchange/build_*.log
rust-exchange/check_*.txt
rust-exchange/check_release.txt
rust-exchange/test_*.txt
rust-exchange/test_sec_*.txt
rust-exchange/bench_results.txt
rust-exchange/benchmark_*_results.txt
rust-exchange/benchmark_v4_quick.txt
rust-exchange/e2e_bench_report.txt
rust-exchange/final_build.txt
rust-exchange/final_release_build.txt
rust-exchange/*.pdb

# Top-level build scratch
/build_log.txt
/build_output.txt

# Per-run P0 artifacts (keep the schema, not the per-run output)
rust-exchange/artifacts/
/artifacts/

# WAL state backups created by recovery drills (forensic only, never committed)
data.bak.*/

# IDE solution files
*.sln

# Codex agent local logs
rust-exchange/.codex-logs/

# Claude Code local settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# Pre-audit recovery snapshots (one-off, keep on disk)
/pre_audit_full_diff_*.patch
/pre_audit_full_diff_*.stderr.txt
/pre_audit_untracked_*.tar.gz
/pre_audit_untracked_*.tar.stderr.txt
/pre_audit_untracked_list_*.txt
/pre_audit_untracked_filtered_*.txt

# OS-specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp
.codex_tmp/
.gocache/
rust-exchange/scripts/__pycache__/
rust-exchange/live_metrics*.json
rust-exchange/live_submit_cancel_ab*.json

# Local deliverables and mutable archive aliases
deliverables/
docs/benchmarks/archives/*_latest/
docs/benchmarks/archives/
docs/neurips_track/arxiv/versions/

# Node modules (for frontend)
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/

# Coverage
coverage/
*.coverprofile

# Debug files
debug/
__debug_bin

# Generated files
*.gen.go
